# ==========================================
# Infrastructure Issue Detection Service
# Variables de Entorno - PLANTILLA
# ==========================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Reemplaza todos los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas el archivo .env al repositorio
# ==========================================

# Flask Configuration
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database
DB_PATH=smart_band.db

# YOLO Model Configuration
# Path to the trained YOLO model file (relative to project root)
YOLO_MODEL_PATH=./models/best.pt
YOLO_CONF_THRESHOLD=0.30
YOLO_IMGSZ=640

# Cloudinary Configuration - Image Storage
# Get these credentials from https://cloudinary.com/console/settings/security
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=detecciones

# Confidence Thresholds by Category
# Minimum confidence required to consider detection as valid
THRESHOLD_BACHE=0.30
THRESHOLD_BASURA_ACUMULADA=0.40
THRESHOLD_SEMAFORO_MALOGRADO=0.45
THRESHOLD_POSTE_CAIDO=0.35

# IAM Authentication
IAM_SECRET_KEY=your-secret-key-here-change-in-production

# Admin Access Token (para endpoints administrativos)
ADMIN_TOKEN=admin-secret-token-change-in-production

# 🆕 Cliente Backend Principal (Auto-registro)
# Estas credenciales deben ser compartidas con el backend principal
# El backend principal las usará en sus llamadas al Edge Service
# IMPORTANTE: Genera una API Key segura de al menos 64 caracteres
# Comando: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_CLIENT_ID=backend-reportes-infrastructure-prod
BACKEND_API_KEY=generate-a-secure-api-key-min-64-chars-using-secrets-module
BACKEND_CLIENT_NAME=Backend Principal - Sistema de Reportes de Infraestructura

# Logging
LOG_LEVEL=INFO

# Backend Principal Integration
BACKEND_PRINCIPAL_URL=http://localhost:8000

# Feature Flags
ASYNC_PROCESSING=True
MAX_BATCH_SIZE=10
IMAGE_DOWNLOAD_TIMEOUT=30
INFERENCE_TIMEOUT=60
